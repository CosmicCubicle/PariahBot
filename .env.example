DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
GUILD_ID=your-test-guild-id-here

# Optional: mirror the command audit log to Discord channels.
# LOG_CHANNEL_ID is used for both successes and failures unless the more
# specific channels below are set. Leave blank to log to logs/commands.log only.
LOG_CHANNEL_ID=
LOG_CHANNEL_SUCCESS_ID=
LOG_CHANNEL_ERROR_ID=

# Optional: Twitch and YouTube alerts (/streamers). Each platform turns on
# independently, as soon as its credentials are set.
#
# Twitch go-live alerts: register an application at
# https://dev.twitch.tv/console/apps (any OAuth redirect URL works, e.g.
# http://localhost) and copy its Client ID and a Client Secret here. Leave
# blank to keep the feature off.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube live and upload alerts: in https://console.cloud.google.com, create
# a project, enable "YouTube Data API v3", and create an API key (restrict it
# to that API). The free daily quota covers roughly 100 followed channels.
YOUTUBE_API_KEY=

# Optional: Instagram post alerts (/instagram). Uses the Graph API's Business
# Discovery, so only public Business or Creator accounts can be followed.
# Needs a Meta developer app and your own Instagram Business/Creator account
# linked to a Facebook Page, all in a Meta business portfolio. Use a System
# User token (Business Settings -> Users -> System users), with the app, Page
# and Instagram account assigned, expiration "Never", and instagram_basic,
# instagram_manage_insights, pages_show_list, pages_read_engagement and
# business_management. It never needs renewing (the wiki has the steps).
# INSTAGRAM_BUSINESS_ACCOUNT_ID is your own account's Instagram user ID.
# Leave both blank to keep the feature off.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
